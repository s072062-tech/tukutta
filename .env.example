# Copy to .env.local for local development (Supabase Local).
# Do not put production credentials here.
# Values: run `npx supabase status` in tukutta/

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. From `npx supabase status` → Secret / service_role key. Never use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Prisma User.id used for admin checks in local only
# NEXT_ADMIN_USER_ID=
